[Unit]
Description=Retry saved camera Wi-Fi networks and compare signal
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=oneshot
Environment=LC_ALL=C
ExecStart=/usr/bin/python3 /usr/local/libexec/promich-wifi-supervisor.py
StateDirectory=promich-wifi-supervisor
StateDirectoryMode=0700
TimeoutStartSec=50
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
